{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@devboard/shared": ["../shared/types/index.ts"]
    }
  },
  "include": ["src/**/*", "server.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
